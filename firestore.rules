rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Waitlist collection: Anyone can register their email for Android App launch
    match /waitlist/{entryId} {
      allow create: if request.resource.data.email is string && request.resource.data.email.size() > 3;
      allow read: if true;
      allow update, delete: if request.auth != null;
    }

    // User profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // User captured / resurrected trips
    match /trips/{tripId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || resource.data.userId == 'anonymous');
    }

    // AI travel chronicles & story outputs
    match /ai_stories/{storyId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Saved passport stamps & postcards
    match /passports/{passportId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
